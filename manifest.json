{
  "manifest_version": 3,
  "name": "Unfriended",
  "version": "1.0",
  "description": "Sort your Facebook friends by how long you've been quiet, then filter Facebook's friend list down to the ones you want to remove.",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Open Unfriended", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
